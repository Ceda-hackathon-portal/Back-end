NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://ceda:replace-me@127.0.0.1:5432/ceda_dev
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:5173
# Local password sign-in refuses to start when AUTH_ENABLED=true. Set it to true only for Cognito.
AUTH_ENABLED=false
AUTH_MODE=local

AUTH_API_ORIGIN=http://localhost:3001
AUTH_FRONTEND_ORIGIN=http://localhost:5173
# Optional local auth: AUTH_MODE=local (development and loopback bind only).
# Generate AUTH_LOCAL_PASSWORD_HASH with `npm run auth:hash-local-password` in backend/.
# Set AUTH_LOCAL_EMAIL and AUTH_ENCRYPTION_KEY (64 random hex chars) in ignored .env.
# To enable approved hosted login, supply COGNITO_ISSUER, COGNITO_CLIENT_ID
# and a server-only 64-hex AUTH_ENCRYPTION_KEY. Client secret is optional.
# Production requires HTTPS and DATABASE_SSL=true; DATABASE_CA_FILE is optional.
# AUTH_LOCAL_ACCOUNTS_FILE= (extra development sign-ins, written by scripts/provision-local.mjs)
# AUTH_LOCAL_PUBLIC_DEMO=true lets the same fictional local accounts sign in on the hosted prototype. It requires
# NODE_ENV=production, DATABASE_SSL=true and AUTH_API_ORIGIN = AUTH_FRONTEND_ORIGIN = the HTTPS frontend that proxies /api.
# Staff assignment needs its own login in ops/assignment-provisioner-role.sql's role. Without it those commands return 503.
# ASSIGNMENT_DATABASE_URL=
# Read-only officer HTTP remains opt-in; requires approved assignment/conflict provisioning.
OFFICER_READ_API_ENABLED=false

# Private local file store (keep outside any static/public directory).
APPLICATION_STORAGE_DIR=.runtime/application-files

AUTH_LOCAL_EMAIL=dev-applicant@example.test
AUTH_LOCAL_NAME=Development Applicant
AUTH_LOCAL_PASSWORD_HASH=
AUTH_ENCRYPTION_KEY=

# Applicant email notifications (off unless SMTP_HOST, SMTP_USER and SMTP_PASS are set).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<gmail address>, SMTP_PASS=<16-character App Password>.
# MAIL_REDIRECT_TO sends every notification to one inbox (demo accounts use fictional addresses).
# MAIL_LINK_ORIGIN is the frontend origin used for links in emails.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=CEDA Innovation Portal <sender@example.org>
# MAIL_REDIRECT_TO=
# MAIL_LINK_ORIGIN=
